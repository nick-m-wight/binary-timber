# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# `.env*` is gitignored (except this example). See docs/SCOPING.md §4.

# --- Email (Resend) ---
# Transactional email for the contact form (app/api/contact/route.ts).
RESEND_API_KEY=
# Sender address. Defaults to hello@chefhub.dev if unset. Set to
# hello@binarytimber.com once that domain is verified in Resend.
RESEND_FROM=
# Recipient for contact-form and intake-submission notifications.
ADMIN_EMAIL=

# --- Supabase (added in Phase 2 — auth + database) ---
# From: Supabase project -> Settings -> API keys. Use the DEV project locally.
# NEXT_PUBLIC_* values are exposed to the browser (safe: the publishable key is RLS-gated).
# The secret key is SERVER-ONLY — never prefix it with NEXT_PUBLIC_.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
